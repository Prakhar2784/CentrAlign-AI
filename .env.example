# CentrAlign AI - Autonomous Task Worker Configuration

# Application
APP_NAME="CentrAlign AI - Autonomous Task Worker"
APP_HOST="0.0.0.0"
APP_PORT=8000
DATABASE_URL="sqlite:///./centralign_task_worker.db"

# LLM Configuration (Set GEMINI_API_KEY to use Gemini, or leave empty to use built-in Deterministic ReAct Reasoner)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="auto"  # 'auto', 'gemini', 'mock'
LLM_MODEL="gemini-2.5-flash"

# Controlled Demo Failure Triggers (for demonstration scenarios)
FAIL_FIRST_UPDATE=false
FAIL_VERIFICATION=false
